class Solution {
    public List<Integer> findMissingElements(int[] arr) {
        Arrays.sort(arr);
        int min = arr[0], max = arr[arr.length-1];
        ArrayList<Integer> list = new ArrayList<>();
        for(int i=min; i<=max; i++)
        {
            list.add(i);
        }
        for(int i=0;i<arr.length;i++)
        {
            list.remove(arr[i]);
        }
        return list;
    }
}
