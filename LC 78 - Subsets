class Solution {
    List<List<Integer>> ans = new ArrayList<>();
    public List<List<Integer>> subsets(int[] nums) 
    {
         subset(0,nums,new ArrayList<>());
         return ans;   
    }
    public void subset(int ind, int nums[], List<Integer>curr)
    {
        if(ind == nums.length)
        {
            ans.add(new ArrayList<>(curr));
            return;
        }
        curr.add(nums[ind]); //take
        subset(ind+1,nums,curr); 
        curr.remove(curr.size()-1); //not take
        subset(ind+1,nums,curr);
    }
}
