public class Solution extends GuessGame {
    public int guessNumber(int n) {
        if(n == 1) return n;
        int min = 0, max = n;
        while(min<=max)
        {
            int sum = min+(max - min)/2;
            if(guess(sum) == 0)
            {
                return sum;
            }
            else if(guess(sum)==-1)
            {
                max = sum-1;
            }
            else
            {
                min = sum+1;
            }
        }
        return 0;
    }
}
