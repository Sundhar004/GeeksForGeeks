class Solution {
    public boolean isPowerOfTwo(int n) {
        if(n == 1)
        {
            return true;
        }
        if(n<0 || n%2 != 0)
        {
            return false;
        }
        boolean ans = f(n);
        return ans; 
    }
    public static boolean f(int n)
    {
        if(n == 0 || n%2 != 0)
        {
            return false;
        }
        if(n == 2)
        {
            return true;
        }
        n = n/2;
        return f(n);
    }
}
